PORT=4000
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: CORS origins (comma-separated). Defaults to localhost doctor-admin.
CORS_ORIGINS=http://localhost:3000
# Invite redirect after accepting setup link
INVITE_REDIRECT_TO=http://localhost:3000/auth/callback
# Optional: required by POST /bootstrap/admin when set
BOOTSTRAP_SECRET=dev-only-change-me

# Phase 4 — Razorpay (B2C checkout). If keys are unset, backend uses dev_bypass
# so the patient app can confirm without a real gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → signing secret (payment.captured)
RAZORPAY_WEBHOOK_SECRET=
# Force mock confirm even when keys exist (local only)
# PAYMENTS_DEV_BYPASS=true
# Public URL the phone/simulator can reach for hosted Checkout.js
# (use your LAN IP when testing on a device, e.g. http://192.168.1.10:4000)
PUBLIC_BACKEND_URL=http://localhost:4000
# Deep-link scheme for Checkout return (must match app.json "scheme")
PAYMENT_CALLBACK_SCHEME=teleconsultapp
